{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scorpion-ai",
  "main": "api/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // vars removed: OPERATOR_TOKEN is now a Freebuff Sites variable
  // "vars": {
  //   "OPERATOR_TOKEN": "operator-secret-2026"
  // },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scorpion-access",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
